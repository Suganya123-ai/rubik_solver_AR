<?xml version="1.0" encoding="utf-8"?>
<!-- The phone is the remote control (held upright): a bar of the app's own buttons on top,
     then the tutor page. The raw camera picture sits under the page ("Camera" shows it). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#FF000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="#FF0B1118">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoom"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Zoom 2x"
            android:textAllCaps="false"
            android:textColor="#FF7FE8FF"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGlassesView"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.7"
            android:enabled="false"
            android:text="No glasses screen"
            android:textAllCaps="false"
            android:textColor="#FF7FE8FF"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleView"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Camera"
            android:textAllCaps="false"
            android:textColor="#FF7FE8FF"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="#FFFF8A8A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/uploadStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF0B1118"
        android:fontFamily="monospace"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:text=""
        android:textColor="#FF8FA3B5"
        android:textSize="10sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextureView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/cameraStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:background="#88000000"
            android:padding="8dp"
            android:text="Initializing camera..."
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="#88000000"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:text=""
            android:textColor="#FF00FF00"
            android:textSize="10sp" />

        <!-- The tutor page (remote-camera mode) covers the raw picture. -->
        <WebView
            android:id="@+id/tutorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
