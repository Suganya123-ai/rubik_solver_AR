# Standard Unity project .gitignore. Place this at the Unity project root
# (the folder containing Assets/, ProjectSettings/, Packages/) once you've
# created that project locally and copied UnityProject/Assets/RubikSolverAR/
# into it.

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Autogenerated IDE/project files
.vs/
.vscode/
*.csproj
*.sln
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files you DO want to keep are *.meta -- don't ignore those.
# OS files
.DS_Store
Thumbs.db

# Never commit a Unity license file or keystore passwords
*.ulf
*.keystore
