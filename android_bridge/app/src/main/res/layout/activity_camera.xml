<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The tutor page (remote-camera mode) covers the raw picture; "Camera" hides it for checking the picture. -->
    <WebView
        android:id="@+id/tutorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/uploadStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF7FE8FF"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:background="#88000000"
        android:padding="6dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp" />

    <TextView
        android:id="@+id/cameraStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Initializing camera..."
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:background="#88000000"
        android:padding="12dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/fpsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF00FF00"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:background="#88000000"
        android:padding="8dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Close"
        android:alpha="0.6"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="#FFFFFFFF"
        app:strokeColor="#FFFFFFFF"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:cornerRadius="24dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleView"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Camera"
        android:alpha="0.6"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="#FFFFFFFF"
        app:strokeColor="#FFFFFFFF"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:cornerRadius="24dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="100dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGlassesView"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="No glasses screen"
        android:enabled="false"
        android:alpha="0.6"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="#FFFFFFFF"
        app:strokeColor="#FFFFFFFF"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:cornerRadius="24dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="210dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnZoom"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Zoom 2x"
        android:alpha="0.6"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="#FFFFFFFF"
        app:strokeColor="#FFFFFFFF"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:cornerRadius="24dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="400dp"
        android:layout_marginBottom="8dp" />

</FrameLayout>
